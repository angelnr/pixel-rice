Context=Places
Type=Scalable
MinSize=8
MaxSize=512

[scalable/categories]
Size=16
Context=Categories
Type=Scalable
MinSize=8
MaxSize=512

[scalable/devices]
Size=16
Context=Devices
Type=Scalable
MinSize=8
MaxSize=512

[scalable/mimetypes]
Size=16
Context=MimeTypes
Type=Scalable
MinSize=8
MaxSize=512

[scalable/status]
Size=16
Context=Status
Type=Scalable
MinSize=8
MaxSize=512

[scalable/actions]
Size=16
Context=Actions
Type=Scalable
MinSize=8
MaxSize=512
