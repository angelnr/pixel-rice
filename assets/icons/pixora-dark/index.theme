[Icon Theme]
Name=Pixora Dark
Comment=16 bit icon theme
Inherits=breeze-dark,hicolor
Directories=scalable/apps,scalable/places,scalable/categories,scalable/devices,scalable/mimetypes,scalable/status,scalable/actions

[scalable/apps]
Size=16
Context=Applications
Type=Scalable
MinSize=8
MaxSize=512

[scalable/places]
