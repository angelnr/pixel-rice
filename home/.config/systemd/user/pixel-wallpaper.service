[Unit]
Description=Pixel wallpaper daemon (per-level random wallpapers + crossfade)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Environment=GDK_BACKEND=wayland
ExecStart=%h/.local/bin/pixel-wallpaperd.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
