[Unit]
Description=OSD de volumen/brillo (notificacion unica que se actualiza)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/.local/bin/osd-daemon.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
