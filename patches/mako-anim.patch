+	notif->slide_timer = add_event_loop_timer(&state->event_loop,
+		SLIDE_STEP_MS, handle_notification_slide, notif);
+
 	notification_execute_binding(notif, &notif->style.notify_binding, NULL);
 
 	set_dirty(notif->surface);
