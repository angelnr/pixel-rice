index 1f91431..68bbc5d 100644
--- a/dbus/xdg.c
+++ b/dbus/xdg.c
@@ -81,13 +81,70 @@ static int handle_get_capabilities(sd_bus_message *msg, void *data,
 	return 0;
 }
 
+#define FADE_OUT_MS 2000
+#define FADE_STEP_MS 16
+#define SLIDE_STEP_MS 16
+#define SLIDE_STEP_PX 16
+
+static void handle_notification_slide(void *data) {
+	struct mako_notification *notif = data;
+	struct mako_surface *surface = notif->surface;
+	notif->slide_timer = NULL;
+
+	if (notif->slide_offset <= SLIDE_STEP_PX) {
+		notif->slide_offset = 0;
+		if (surface != NULL) {
+			set_dirty(surface);
+		}
+		return;
+	}
+
+	notif->slide_offset -= SLIDE_STEP_PX;
+	if (surface != NULL) {
+		set_dirty(surface);
+	}
+	notif->slide_timer = add_event_loop_timer(&notif->state->event_loop,
+		SLIDE_STEP_MS, handle_notification_slide, notif);
+}
+
+static void handle_notification_fade(void *data) {
+	struct mako_notification *notif = data;
+	struct mako_surface *surface = notif->surface;
+	notif->fade_timer = NULL;
+
+	notif->fade_elapsed_ms += FADE_STEP_MS;
+	if (notif->fade_elapsed_ms >= FADE_OUT_MS) {
+		notif->opacity = 0.0;
+		close_notification(notif, MAKO_NOTIFICATION_CLOSE_EXPIRED, true);
+		if (surface != NULL) {
+			set_dirty(surface);
+		}
+		return;
+	}
+
+	notif->opacity = 1.0 -
+		(double)notif->fade_elapsed_ms / (double)FADE_OUT_MS;
+	if (surface != NULL) {
+		set_dirty(surface);
+	}
+	notif->fade_timer = add_event_loop_timer(&notif->state->event_loop,
+		FADE_STEP_MS, handle_notification_fade, notif);
+}
+
 static void handle_notification_timer(void *data) {
 	struct mako_notification *notif = data;
 	struct mako_surface *surface = notif->surface;
 	notif->timer = NULL;
 
-	close_notification(notif, MAKO_NOTIFICATION_CLOSE_EXPIRED, true);
-	set_dirty(surface);
+	if (surface == NULL) {
+		close_notification(notif, MAKO_NOTIFICATION_CLOSE_EXPIRED, true);
+		return;
+	}
+
+	notif->fade_elapsed_ms = 0;
+	notif->opacity = 1.0;
+	notif->fade_timer = add_event_loop_timer(&notif->state->event_loop,
+		FADE_STEP_MS, handle_notification_fade, notif);
 }
 
 static int handle_notify(sd_bus_message *msg, void *data,
@@ -427,6 +484,10 @@ static int handle_notify(sd_bus_message *msg, void *data,
